# AeroGuard AI Mobile App Environment
# Set this to the backend API URL.
# For local development with the emulator on the same machine:
#   EXPO_PUBLIC_API_URL=http://localhost:8000
# For a physical device on the same WiFi network:
#   EXPO_PUBLIC_API_URL=http://192.168.1.XXX:8000

EXPO_PUBLIC_API_URL=http://localhost:8000
